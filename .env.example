# Copie este archivo como .env y complete los valores. El archivo .env NO se sube al repositorio.

PORT=3000
DATABASE_URL=postgresql://postgres:su_contrasena@localhost:5432/asistia
# Si usa Next.js con el comando "next dev -p 3001", configure el origen en 3001.
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Secreto de sesión. Use un valor aleatorio, no esta cadena de ejemplo.
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_largo
JWT_EXPIRA=8h
# Debe ser aleatorio, de al menos 32 caracteres y DIFERENTE de JWT_SECRET.
JWT_RESET_SECRET=reemplazar_por_otro_secreto_aleatorio_largo_y_distinto
RESET_TOKEN_MINUTOS=15

# Contraseñas iniciales de demostración para la cuenta de administrador y la cuenta de usuario.
# Use contraseñas distintas en entornos reales. Las cuentas de demostración usan correos .invalid.
ADMIN_SEED_PASSWORD=CambieAdmin2026
USER_SEED_PASSWORD=CambieUsuario2026
USER_DEMO_EMAIL=usuario.demo@ejemplo.invalid
# Correo por cuenta administrativa. Cambie los .invalid por correos reales para habilitar recuperación.
ADMIN_GLOBAL_EMAIL=admin@ejemplo.invalid
ADMIN_ADMISIONES_EMAIL=admin_admisiones@ejemplo.invalid
ADMIN_REGISTRO_EMAIL=admin_registro@ejemplo.invalid
ADMIN_BIENESTAR_EMAIL=admin_bienestar@ejemplo.invalid
ADMIN_COORDINACION_EMAIL=admin_coordinacion@ejemplo.invalid

# Correo transaccional para los enlaces de recuperación (Remitente verificado en Resend).
# Si no se configura, el backend arranca pero no podrá enviar correos reales de recuperación.
RESEND_API_KEY=
RESEND_FROM=

# Servicio de IA: 'openai' (real) o 'simulador' (sin clave ni costo, solo para desarrollo).
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Modelo de OpenAI que soporte Structured Outputs. Verifique el nombre vigente en su cuenta de OpenAI.
OPENAI_MODEL=
AI_TIMEOUT_MS=30000

# Límites (opcionales)
CHAT_LIMITE=20
LOGIN_LIMITE=20
RECUPERACION_LIMITE=5
RESET_LIMITE=10
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asistia_test
