{
  "name": "asistia-backend",
  "version": "0.1.0",
  "description": "AsistIA - Back-end (API REST) del asistente conversacional con IA generativa para las divisiones de TEINCO",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed-reportes": "node scripts/seed-reportes.js",
    "db:cargar-info-general": "node scripts/cargar-info-general.js",
    "test": "node --test --test-concurrency=1",
    "probar:openai": "node scripts/probar-openai.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.34.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
